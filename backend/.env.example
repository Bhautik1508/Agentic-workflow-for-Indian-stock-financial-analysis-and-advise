# Backend Environment Variables
# Copy this to .env for local dev. Set these directly in Render dashboard for production.

# === LLM APIs ===
# Gemini is the PRIMARY analysis model; Groq is the FALLBACK tier.
# The router fails over on any error (rate limit, 404 model retired, 401, 5xx),
# so keeping both keys set means one vendor outage degrades instead of breaking.
GOOGLE_API_KEY=                  # PRIMARY - https://aistudio.google.com/app/apikey
GROQ_API_KEY=                    # FALLBACK - https://console.groq.com/keys

# --- Optional LLM tuning (sane defaults if left blank) ---
LLM_PRIMARY_PROVIDER=gemini      # gemini | groq  - flips the chain order
GEMINI_MODEL=                    # default: gemini-3.5-flash-lite (own RPM bucket; serves under 6-agent load)
GEMINI_FALLBACK_MODEL=           # default: gemini-3.6-flash (stronger; used when it has headroom)
GEMINI_RETRIES=                  # default: 0 - same-model retries measurably do not help
GEMINI_THINKING_BUDGET=          # leave BLANK. Gemini 3.x rejects a 0 budget with HTTP 400.
GROQ_MODEL=                      # default: openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=             # default: openai/gpt-oss-20b
ANALYST_CONCURRENCY=             # default: 5 (all analysts in parallel)
JUDGE_THINKING_BUDGET=           # reasoning tokens for the judge only; blank = model default
AGENT_PROMPT_TOKEN_BUDGET=       # default: 6000 - logs a warning when a prompt exceeds it

# === LLM pricing (optional) ===
# USD per 1M tokens, so each run can report what it cost. Unset = costs show as
# "not set" rather than a fabricated $0.00. Rates: ai.google.dev/pricing, groq.com/pricing
# LLM_PRICING_JSON={"gemini-3.5-flash-lite":{"input":0.10,"output":0.40},"gemini-3.6-flash":{"input":0.30,"output":2.50}}
LLM_PRICING_JSON=

# === News APIs ===
NEWS_API_KEY=                    # https://newsapi.org/account
MARKETAUX_API_KEY=               # https://www.marketaux.com/account/dashboard
# ALPHA_VANTAGE_KEY=             # Retired: no Indian fundamentals coverage on the free tier

# === CORS (Production) ===
# Comma-separated list of allowed frontend origins. Set in Render dashboard after Vercel deploy.
# Example: https://your-app.vercel.app
ALLOWED_ORIGINS=

# === Optional: Redis Cache (Upstash) ===
# Leave blank to use local file-based cache instead
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# === Optional: Supabase ===
# Leave blank if not using
SUPABASE_URL=
SUPABASE_KEY=

